<Window x:Class="HearingProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HearingProfileManager.ViewModels"
        Title="Hearing Profile Manager" Height="500" Width="600">

    <!-- Connect ViewModel to View -->
    <Window.DataContext>
        <vm:PatientViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Hearing Profile Manager"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Name input -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Name:" Width="80" VerticalAlignment="Center"/>
            <TextBox Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Height="30" Padding="5"/>
        </StackPanel>

        <!-- Age input -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Age:" Width="80" VerticalAlignment="Center"/>
            <TextBox Text="{Binding InputAge, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Height="30" Padding="5"/>
        </StackPanel>

        <!-- Hearing Loss Level -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Loss Level:" Width="80" VerticalAlignment="Center"/>
            <ComboBox SelectedItem="{Binding InputLevel}"
                      Width="300" Height="30">
                <ComboBoxItem Content="Mild"/>
                <ComboBoxItem Content="Moderate"/>
                <ComboBoxItem Content="Severe"/>
            </ComboBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,15">
            <Button Content="Add Patient"
                    Command="{Binding AddPatientCommand}"
                    Width="120" Height="35" Margin="0,0,10,0"
                    Background="#2196F3" Foreground="White"/>
            <Button Content="Delete Selected"
                    Command="{Binding DeletePatientCommand}"
                    Width="120" Height="35"
                    Background="#f44336" Foreground="White"/>
        </StackPanel>

        <!-- Patient List -->
        <!-- Patient List -->
        <ListBox Grid.Row="5"
         ItemsSource="{Binding Patients}"
         SelectedItem="{Binding SelectedPatient}"
         Margin="0,10,0,0"
         DisplayMemberPath="Name"/>

    </Grid>
</Window>